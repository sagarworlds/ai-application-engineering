{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "Authority": "",
        "ValidAudiences": [ "api://knowledge-assistant" ]
      }
    }
  },
  "Llm": {
    "BaseUrl": "",
    "ApiKeyHeaderName": "Authorization",
    "ChatModel": "",
    "EmbeddingModel": "",
    "RequestTimeout": "00:00:30",
    "StreamTimeout": "00:02:00",
    "MaxTokensParameterName": "max_tokens",
    "StructuredOutputMode": "JsonSchema"
  },
  "Generation": {
    "ChatTemperature": 0.7,
    "AnswerTemperature": 0.1,
    "MaxOutputTokens": 1024
  },
  "Conversation": {
    "MaxHistoryMessages": 6,
    "MaxHistoryCharacters": 6000
  },
  "ConnectionStrings": {
    "KnowledgeDb": "Data Source=App_Data/knowledge.db"
  }
}
